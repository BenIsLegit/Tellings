    "tauri": "tauri",
    "pvc": "cargo run --quiet --release -p pvc --"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-log": "2.10.2",
    "lucide-svelte": "1.0.1",
    "svelte-sonner": "1.2.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "24.19.2",
    "svelte": "5.58.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
