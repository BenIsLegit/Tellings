{
  "name": "prayer-video-creator",
  "version": "0.1.0",
  "description": "Makes follow-along prayer videos for the beads you are holding.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
